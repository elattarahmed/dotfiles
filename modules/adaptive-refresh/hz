#!/usr/bin/env python3
"""Live refresh rate of the built-in panel, read from the kernel vblank counter.

Reading the counter does not draw anything, so it measures the panel's real
refresh rate under VRR without forcing it up (unlike a browser test page).

  hz            live view in this terminal (Ctrl+C to quit)
  hz --toggle   open it in a small floating terminal, or close it if open
  hz --once     print one measurement (1 s) and exit
"""
import fcntl
import glob
import os
import signal
import struct
import subprocess
import sys
import time

def builtin_card():
    """/dev/dri/cardN that drives the built-in screen (its eDP connector)."""
    for entry in sorted(glob.glob("/sys/class/drm/card*-eDP-*")):
        return "/dev/dri/" + os.path.basename(entry).split("-", 1)[0]
    return "/dev/dri/card0"


CARD = os.environ.get("HZ_CARD") or builtin_card()
PIPE = int(os.environ.get("HZ_PIPE", "0"))  # CRTC index of the built-in screen
INTERVAL = 0.5

# DRM_IOCTL_WAIT_VBLANK = _IOWR('d', 0x3a, union drm_wait_vblank), 24 bytes.
IOCTL = (3 << 30) | (24 << 16) | (ord("d") << 8) | 0x3A
VBLANK_RELATIVE = 0x1
VBLANK_SECONDARY = 0x20000000
VBLANK_HIGH_CRTC_SHIFT = 1


def vblank_type(pipe):
    if pipe == 0:
        return VBLANK_RELATIVE
    if pipe == 1:
        return VBLANK_RELATIVE | VBLANK_SECONDARY
    return VBLANK_RELATIVE | ((pipe << VBLANK_HIGH_CRTC_SHIFT) & 0x3E)


def read_counter(fd):
    """Return (vblank sequence, time of that vblank) without waiting."""
    req = struct.pack("IIQQ", vblank_type(PIPE), 0, 0, 0)
    _, seq, sec, usec = struct.unpack("IIqq", fcntl.ioctl(fd, IOCTL, req))
    return seq, sec + usec / 1e6


def measure(fd, seconds):
    s1, _ = read_counter(fd)
    t1 = time.monotonic()
    time.sleep(seconds)
    s2, _ = read_counter(fd)
    t2 = time.monotonic()
    return ((s2 - s1) & 0xFFFFFFFF) / (t2 - t1)


def live(fd):
    lo, hi = None, None
    out = sys.stdout
    out.write("\033[?25l")  # hide the terminal cursor
    try:
        while True:
            hz = measure(fd, INTERVAL)
            lo = hz if lo is None else min(lo, hz)
            hi = hz if hi is None else max(hi, hz)
            bar = "█" * round(hz / 120 * 24)
            out.write(
                f"\r\033[K {hz:5.0f} Hz  {bar:<24}  min {lo:3.0f}  max {hi:3.0f}"
            )
            out.flush()
    except KeyboardInterrupt:
        pass
    finally:
        out.write("\033[?25h\n")


PIDFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hz-live.pid")


def running_live_pid():
    """PID of the open live window, from its PID file, if it is still ours."""
    try:
        pid = int(open(PIDFILE).read().strip())
        cmdline = open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")
    except (OSError, ValueError):
        return None
    if b"--live" in cmdline and any(arg.endswith(b"/hz") for arg in cmdline):
        return pid
    return None


def toggle():
    me = os.path.realpath(__file__)
    pid = running_live_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)  # the terminal closes when hz exits
        return
    subprocess.Popen(
        ["omarchy-launch-tui", "--app-id=org.omarchy.hz", me, "--live"],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "--live"
    if arg == "--toggle":
        toggle()
        return
    fd = os.open(CARD, os.O_RDWR)
    if arg == "--once":
        print(f"{measure(fd, 1.0):.0f} Hz")
    elif arg == "--live":
        with open(PIDFILE, "w") as f:
            f.write(str(os.getpid()))
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        try:
            live(fd)
        finally:
            if running_live_pid() == os.getpid():
                os.unlink(PIDFILE)
    else:
        print(__doc__.strip())


if __name__ == "__main__":
    main()
