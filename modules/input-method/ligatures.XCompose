# Joined letters on the French layout, with AltGr:
#   AltGr+O then E: œ        AltGr+Shift+O then E: Œ
#   AltGr+A then E: æ        AltGr+Shift+A then E: Æ
# AltGr+O / AltGr+A type ø / æ, which now wait for the next key. The E works
# with AltGr still held (it types € or ¢ then) and with Shift held or not.
<oslash> <e> : "œ" oe
<oslash> <EuroSign> : "œ" oe
<Oslash> <E> : "Œ" OE
<Oslash> <e> : "Œ" OE
<Oslash> <cent> : "Œ" OE
<Oslash> <EuroSign> : "Œ" OE
<ae> <e> : "æ" ae
<ae> <EuroSign> : "æ" ae
<AE> <E> : "Æ" AE
<AE> <e> : "Æ" AE
<AE> <cent> : "Æ" AE
<AE> <EuroSign> : "Æ" AE
