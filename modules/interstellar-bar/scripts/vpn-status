#!/bin/bash
# Bar module: VPN up (WireGuard or tun interface) or down. Down is marked
# "active" so the bar shows it in its attention color: traffic unprotected.

iface=$(ip -o link show type wireguard 2>/dev/null | awk -F': ' 'NR == 1 {print $2}')
[[ -n $iface ]] || iface=$(ip -o link show 2>/dev/null | grep -oE 'tun[0-9]+' | head -1)

if [[ -n $iface ]]; then
  jq -cn --arg iface "$iface" '{text: "󰦝", tooltip: "VPN active: \($iface)"}'
else
  jq -cn '{text: "󰦞", tooltip: "No VPN — traffic unprotected", class: "active"}'
fi
