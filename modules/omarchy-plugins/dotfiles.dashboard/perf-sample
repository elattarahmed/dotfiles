#!/bin/bash
# One sample for the dashboard's Performances tab, as one JSON line:
# cpu counters (total, idle), memory (total, available, KiB), CPU package
# temperature (°C), battery (%, status, watts), root disk (% used) and the
# default interface's byte counters. The dashboard turns counters into rates.

read -r cpu_total cpu_idle < <(awk '/^cpu /{s = 0; for (i = 2; i <= NF; i++) s += $i; print s, $5 + $6; exit}' /proc/stat)
read -r mem_total mem_avail < <(awk '/^MemTotal:/{t = $2} /^MemAvailable:/{a = $2} END{print t, a}' /proc/meminfo)

temp=""
for z in /sys/class/hwmon/hwmon*; do
  [[ $(cat "$z/name" 2>/dev/null) == k10temp || $(cat "$z/name" 2>/dev/null) == coretemp ]] || continue
  temp=$(awk '{printf "%.1f", $1 / 1000}' "$z/temp1_input" 2>/dev/null)
  break
done

bat=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -n 1)
capacity=-1 status="" watts=-1
if [[ -n $bat ]]; then
  capacity=$(cat "$bat/capacity" 2>/dev/null || echo -1)
  status=$(cat "$bat/status" 2>/dev/null)
  if [[ -r $bat/power_now ]]; then
    watts=$(awk '{printf "%.1f", $1 / 1e6}' "$bat/power_now")
  elif [[ -r $bat/current_now && -r $bat/voltage_now ]]; then
    watts=$(awk -v c="$(cat "$bat/current_now")" -v v="$(cat "$bat/voltage_now")" 'BEGIN{printf "%.1f", c * v / 1e12}')
  fi
fi

disk=$(df --output=pcent / 2>/dev/null | tail -n 1 | tr -dc '0-9')

iface=$(ip -4 -o route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") print $(i + 1)}')
rx=0 tx=0
if [[ -n $iface && -r /sys/class/net/$iface/statistics/rx_bytes ]]; then
  rx=$(cat "/sys/class/net/$iface/statistics/rx_bytes")
  tx=$(cat "/sys/class/net/$iface/statistics/tx_bytes")
fi

jq -cn --argjson ct "${cpu_total:-0}" --argjson ci "${cpu_idle:-0}" \
  --argjson mt "${mem_total:-0}" --argjson ma "${mem_avail:-0}" \
  --arg temp "$temp" --argjson cap "${capacity:--1}" --arg status "$status" --argjson watts "${watts:--1}" \
  --argjson disk "${disk:-0}" --arg iface "$iface" --argjson rx "$rx" --argjson tx "$tx" \
  '{cpuTotal: $ct, cpuIdle: $ci, memTotal: $mt, memAvail: $ma,
    temp: ($temp | tonumber? // -1), battery: $cap, batteryStatus: $status, watts: $watts,
    disk: $disk, iface: $iface, rx: $rx, tx: $tx, t: now}'
