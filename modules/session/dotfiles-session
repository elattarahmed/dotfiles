#!/usr/bin/env python3
"""Reopen the windows of the last session, where they were.

  dotfiles-session daemon     keep a snapshot of the session, restore it at login
  dotfiles-session save       snapshot now
  dotfiles-session restore [FILE]
                              reopen the saved session (or FILE) now
  dotfiles-session show       what the snapshot holds
  dotfiles-session clear      nothing reopens at the next login (once)
  dotfiles-session map        find the window of tabs opened before this was
                              installed (shows each tab for a moment)

What is saved, for each window: its workspace, floating position and size,
fullscreen and pinned state, and the command and folder that started it. For
Ghostty, every tab of every window: its folder, and the program running in it
when it is one of TAB_COMMANDS (nvim, lazygit…). Apps that restore their own
content (Brave tabs, VS Code folders) bring it back themselves.

The snapshot is kept up to date while you work (a few seconds after windows
change, and every minute for the terminals' folders), and frozen as soon as
the session ends: Omarchy's logout/reboot/shutdown closes every window before
asking systemd, so a snapshot taken then would be empty.

Ghostty doesn't say which tab is in which window: each zsh tab tells it
(~/.zshrc, the window it is focused in), and a reopened tab takes its folder
and program from the queue this writes (see the zshrc).

Settings: ~/.config/dotfiles/session.conf (`skip: <class>` lines, `restore: off`).
"""

import json
import os
import queue
import re
import shlex
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path

HOME = Path.home()
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local" / "state")) / "dotfiles" / "session.json"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "dotfiles" / "session.conf"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "dotfiles-session"
SURFACES = RUNTIME / "surfaces"
QUEUE = RUNTIME / "queue"
SKIP_NEXT = STATE.with_name("session.skip-next")   # `clear`: don't reopen at next login

GHOSTTY = "com.mitchellh.ghostty"
# Never reopened: Omarchy's own windows, dialogs, and VMs (a VM would boot again)
SKIP_PREFIXES = ("org.omarchy.", "xdg-desktop-portal", "polkit", "org.freedesktop.")
SKIP_CLASSES = {"qemu", "hyprland-share-picker", "zenity"}
# Programs a reopened terminal tab starts again
TAB_COMMANDS = {"nvim", "vim", "vi", "lazygit", "btop", "htop", "yazi", "less", "man", "glow", "tig"}

SAVE_DELAY = 3        # seconds after the last window change
SAVE_EVERY = 60       # seconds, for the terminals' folders
WINDOW_EVENTS = ("openwindow", "closewindow", "movewindow", "movewindowv2", "changefloatingmode",
                 "fullscreen", "pin", "moveworkspace", "moveworkspacev2")


def log(*parts):
    print("dotfiles-session:", *parts, file=sys.stderr, flush=True)


# --- Hyprland -----------------------------------------------------------------

def hypr_socket(name):
    return Path(os.environ["XDG_RUNTIME_DIR"]) / "hypr" / os.environ["HYPRLAND_INSTANCE_SIGNATURE"] / name


def hyprctl_json(what):
    out = subprocess.run(["hyprctl", "-j", what], capture_output=True, text=True, timeout=5).stdout
    return json.loads(out or "null")


def dispatch(expr):
    subprocess.run(["hyprctl", "dispatch", expr], capture_output=True, timeout=5)


def lua_string(value):
    return json.dumps(str(value))


def events():
    """Hyprland's event stream, one (name, data) at a time."""
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(str(hypr_socket(".socket2.sock")))
    buffer = b""
    while True:
        chunk = sock.recv(65536)
        if not chunk:
            return
        buffer += chunk
        *lines, buffer = buffer.split(b"\n")
        for line in lines:
            name, _, data = line.decode(errors="replace").partition(">>")
            yield name, data


# --- /proc --------------------------------------------------------------------

def read(path):
    try:
        return Path(path).read_bytes()
    except OSError:
        return b""


def cmdline(pid):
    return [a.decode(errors="replace") for a in read(f"/proc/{pid}/cmdline").split(b"\0") if a]


def cwd(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return str(HOME)


def environ(pid):
    env = {}
    for entry in read(f"/proc/{pid}/environ").split(b"\0"):
        key, _, value = entry.decode(errors="replace").partition("=")
        if key:
            env[key] = value
    return env


def stat(pid):
    """(ppid, tpgid, starttime) from /proc/PID/stat."""
    raw = read(f"/proc/{pid}/stat").decode(errors="replace")
    fields = raw[raw.rfind(")") + 2:].split()
    if len(fields) < 20:
        return None
    return int(fields[1]), int(fields[5]), int(fields[19])


def processes():
    for entry in os.listdir("/proc"):
        if entry.isdigit():
            yield int(entry)


# --- Settings -----------------------------------------------------------------

def settings():
    skip, restore = set(SKIP_CLASSES), True
    for line in read(CONFIG).decode(errors="replace").splitlines():
        key, _, value = line.partition(":")
        key, value = key.strip().lower(), value.strip()
        if key == "skip" and value:
            skip.add(value)
        elif key == "unskip" and value:
            skip.discard(value)
        elif key == "restore":
            restore = value.lower() not in ("off", "no", "false", "0")
    return skip, restore


def skipped(window, skip):
    names = {window.get("class", ""), window.get("initialClass", "")}
    return any(n.startswith(SKIP_PREFIXES) or n in skip for n in names if n)


# --- Snapshot -----------------------------------------------------------------

def ghostty_tabs():
    """{window address: [tab, ...]} from the zsh tabs' reports (see ~/.zshrc)."""
    tabs = {}
    for pid, surface in zsh_tabs():
        report = read(SURFACES / surface).decode().split()
        if len(report) != 2 or report[1] != str(pid):
            continue
        info = stat(pid)
        if not info:
            continue
        _, tpgid, started = info
        tab = {"cwd": cwd(pid), "command": "", "started": started}
        # The program in the foreground, when it is one worth starting again
        if tpgid > 0 and tpgid != pid:
            argv = cmdline(tpgid)
            if argv and os.path.basename(argv[0]) in TAB_COMMANDS:
                tab["command"] = shlex.join([os.path.basename(argv[0])] + argv[1:])
                tab["cwd"] = cwd(tpgid)
        tabs.setdefault(report[0], []).append(tab)
    for address in tabs:
        tabs[address].sort(key=lambda t: t["started"])
    return tabs


def zsh_tabs():
    """[(pid, surface id)] of the zsh each Ghostty tab started. Programs in a
    tab inherit its GHOSTTY_SURFACE_ID, so only Ghostty's own children count."""
    ghostty = {pid for pid in processes() if os.path.basename((cmdline(pid) or [""])[0]) == "ghostty"}
    found = []
    for pid in processes():
        info = stat(pid)
        if not info or info[0] not in ghostty:
            continue
        surface = environ(pid).get("GHOSTTY_SURFACE_ID")
        if surface and os.path.basename((cmdline(pid) or [""])[0]).lstrip("-") == "zsh":
            found.append((pid, surface))
    return found


def map_tabs():
    """Report the window of tabs that never did (started before the zshrc
    hook): show each one with Ghostty's present-surface and read which window
    got the focus."""
    focused = (hyprctl_json("activewindow") or {}).get("address")
    SURFACES.mkdir(parents=True, exist_ok=True)
    done = 0
    for pid, surface in zsh_tabs():
        report = read(SURFACES / surface).decode().split()
        if len(report) == 2 and report[1] == str(pid):
            continue
        try:
            number = int(surface, 16)
        except ValueError:
            continue
        subprocess.run(["gdbus", "call", "--session", "--dest", "com.mitchellh.ghostty",
                        "--object-path", "/com/mitchellh/ghostty", "--method", "org.gtk.Actions.Activate",
                        "present-surface", f"[<uint64 {number}>]", "{}"], capture_output=True, timeout=5)
        time.sleep(0.25)
        active = hyprctl_json("activewindow") or {}
        if active.get("class") == GHOSTTY:
            (SURFACES / surface).write_text(f"{active['address']} {pid}\n")
            done += 1
    if focused:
        dispatch(f'hl.dsp.focus({{ window = "address:{focused}" }})')
    return done


def snapshot():
    skip, _ = settings()
    clients = hyprctl_json("clients") or []
    tabs = ghostty_tabs()
    windows = []
    for c in clients:
        if not c.get("mapped") or c.get("hidden") or skipped(c, skip):
            continue
        window = {
            "class": c["class"], "initialClass": c.get("initialClass", ""), "title": c.get("title", ""),
            "workspace": c["workspace"]["name"], "floating": c.get("floating", False),
            "at": c.get("at"), "size": c.get("size"), "fullscreen": c.get("fullscreen", 0),
            "pinned": c.get("pinned", False), "pid": c["pid"],
        }
        if c["class"] == GHOSTTY:
            window["tabs"] = [{"cwd": t["cwd"], "command": t["command"]} for t in tabs.get(c["address"], [])] \
                or [{"cwd": str(HOME), "command": ""}]
        else:
            window["cmd"] = cmdline(c["pid"])
            window["cwd"] = cwd(c["pid"])
            if not window["cmd"]:
                continue
        windows.append(window)

    def order(w):
        ws = w["workspace"]
        return (0 if ws.lstrip("-").isdigit() else 1, int(ws) if ws.lstrip("-").isdigit() else 0, ws,
                (w["at"] or [0, 0])[0], (w["at"] or [0, 0])[1])
    windows.sort(key=order)
    return {"version": 1, "instance": os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""),
            "saved": time.strftime("%Y-%m-%d %H:%M:%S"), "windows": windows}


def session_ending():
    """Whether windows are being closed because the session ends."""
    # Omarchy's logout/reboot/shutdown script, or its close-all, running.
    # Checked on the real command (script name and arguments), not on any
    # command line that merely mentions them.
    for pid in processes():
        argv = cmdline(pid)
        names = [os.path.basename(a) for a in argv[:2]]
        if "omarchy-hyprland-window-close-all" in names:
            return True
        if "omarchy-system" in names and set(argv) & {"--execute", "--inhibited"}:
            return True
    state = subprocess.run(["systemctl", "is-system-running"], capture_output=True, text=True).stdout.strip()
    if state == "stopping":
        return True
    prop = subprocess.run(["busctl", "get-property", "org.freedesktop.login1", "/org/freedesktop/login1",
                           "org.freedesktop.login1.Manager", "PreparingForShutdown"],
                          capture_output=True, text=True).stdout
    return "true" in prop


def write_snapshot(snap):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(snap, indent=1, ensure_ascii=False))
    tmp.replace(STATE)


# --- Restore ------------------------------------------------------------------

class Restorer:
    def __init__(self, snap):
        self.snap = snap
        self.apps = []           # saved non-terminal windows still waiting for theirs
        self.lock = threading.Lock()
        self.placing = 0         # windows being placed right now
        self.ghostty_opened = queue.Queue()
        self.known = {c["address"] for c in (hyprctl_json("clients") or [])}

    def place(self, address, window):
        target = f'window = "address:{address}"'
        dispatch(f"hl.dsp.window.move({{ workspace = {lua_string(window['workspace'])}, follow = false, {target} }})")
        floating = bool(window.get("floating"))
        dispatch(f'hl.dsp.window.float({{ action = "{"on" if floating else "off"}", {target} }})')
        self.place_geometry(address, window)
        mode = {1: "maximized", 2: "fullscreen"}.get(window.get("fullscreen", 0))
        if mode:
            dispatch(f'hl.dsp.window.fullscreen({{ mode = "{mode}", action = "set", {target} }})')
        if window.get("pinned"):
            dispatch(f"hl.dsp.window.pin({{ {target} }})")

    def place_geometry(self, address, window):
        if not (window.get("floating") and window.get("size") and window.get("at")):
            return
        target = f'window = "address:{address}"'
        w, h = window["size"]
        x, y = window["at"]
        dispatch(f"hl.dsp.window.resize({{ x = {w}, y = {h}, {target} }})")
        dispatch(f"hl.dsp.window.move({{ x = {x}, y = {y}, {target} }})")

    def on_open(self, data):
        address, _, rest = data.partition(",")
        _, _, rest = rest.partition(",")
        klass, _, title = rest.partition(",")
        address = "0x" + address
        if address in self.known:
            return
        self.known.add(address)
        if klass == GHOSTTY:
            self.ghostty_opened.put(address)
            return
        with self.lock:
            matches = [w for w in self.apps if klass in (w["class"], w["initialClass"])]
            if not matches:
                return
            window = next((w for w in matches if w["title"] == title), matches[0])
            self.apps.remove(window)
            self.placing += 1
        try:
            # Let the app map at its own place first, then move it
            time.sleep(0.3)
            self.place(address, window)
            # Apps that finish sizing themselves after mapping recenter their
            # window: put a floating one back where it was once more
            if window.get("floating"):
                time.sleep(1.2)
                self.place_geometry(address, window)
        finally:
            with self.lock:
                self.placing -= 1

    def listen(self):
        try:
            for name, data in events():
                if name == "openwindow":
                    threading.Thread(target=self.on_open, args=(data,), daemon=True).start()
        except OSError:
            pass

    def launch_apps(self):
        running = {tuple(cmdline(pid)) for pid in processes()}
        launched = set()
        for window in self.snap["windows"]:
            if window["class"] == GHOSTTY:
                continue
            cmd = window["cmd"]
            # One process can hold several windows (a browser): start it once
            key = (window["pid"], tuple(cmd))
            if key in launched:
                with self.lock:
                    self.apps.append(window)
                continue
            if tuple(cmd) in running:
                continue
            launched.add(key)
            with self.lock:
                self.apps.append(window)
            folder = window["cwd"] if os.path.isdir(window["cwd"]) else str(HOME)
            try:
                subprocess.Popen(["uwsm-app", "--", *cmd], cwd=folder, start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError as e:
                log("impossible de relancer", cmd[0], e)

    def claimed(self):
        return len([f for f in QUEUE.glob("*.tab")])

    def wait_claim(self, before, timeout=6):
        end = time.time() + timeout
        while time.time() < end:
            if self.claimed() < before:
                return True
            time.sleep(0.1)
        return False

    def restore_terminals(self):
        windows = [w for w in self.snap["windows"] if w["class"] == GHOSTTY]
        if not windows:
            return
        QUEUE.mkdir(parents=True, exist_ok=True)
        for f in QUEUE.glob("*"):
            f.unlink()
        ghostty_running = subprocess.run(["pgrep", "-x", "ghostty"], capture_output=True).returncode == 0
        seq = 0
        for window in windows:
            tabs = window["tabs"]
            for tab in tabs:
                seq += 1
                (QUEUE / f"{seq:06d}.tab").write_text(f"{tab['cwd']}\n{tab['command']}\n")
            pending = self.claimed()
            if ghostty_running:
                subprocess.Popen(["ghostty", "+new-window"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            else:
                subprocess.Popen(["uwsm-app", "--", "ghostty", "--gtk-single-instance=true"],
                                 start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                ghostty_running = True
            try:
                address = self.ghostty_opened.get(timeout=10)
            except queue.Empty:
                log("Ghostty n'a pas ouvert de fenêtre")
                break
            self.place(address, window)
            self.wait_claim(pending)
            for _ in tabs[1:]:
                pending = self.claimed()
                dispatch(f'hl.dsp.focus({{ window = "address:{address}" }})')
                time.sleep(0.2)
                subprocess.run(["ghostty", "+new-tab"], capture_output=True, timeout=5)
                if not self.wait_claim(pending):
                    log("un onglet ne s'est pas ouvert")
                    break
        for f in QUEUE.glob("*.tab"):
            f.unlink()

    def run(self):
        threading.Thread(target=self.listen, daemon=True).start()
        time.sleep(0.2)
        self.launch_apps()
        self.restore_terminals()
        # Apps that open slowly still get placed for a while
        end = time.time() + 45
        while time.time() < end:
            with self.lock:
                if not self.apps and not self.placing:
                    break
            time.sleep(0.5)
        count = len(self.snap["windows"])
        subprocess.run(["notify-send", "-a", "Session", "Session rouverte",
                        f"{count} fenêtre(s) de la session du {self.snap.get('saved', '?')}"], capture_output=True)


def restore(snap):
    if not snap.get("windows"):
        return
    log(f"restauration de {len(snap['windows'])} fenêtre(s) ({snap.get('saved')})")
    Restorer(snap).run()


def load(path=STATE):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return None


# --- Daemon -------------------------------------------------------------------

def daemon():
    snap = load()
    _, want_restore = settings()
    instance = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    # Same Hyprland as the snapshot: the service restarted mid-session, nothing to reopen
    skip_once = SKIP_NEXT.exists()
    SKIP_NEXT.unlink(missing_ok=True)
    if snap and want_restore and not skip_once and snap.get("instance") != instance:
        time.sleep(2)   # let the shell and the bar come up first
        restore(snap)

    dirty = threading.Event()
    frozen = False

    def watch():
        try:
            for name, _ in events():
                if name in WINDOW_EVENTS:
                    dirty.set()
        except OSError:
            os._exit(1)   # Hyprland went away: systemd restarts the service

    threading.Thread(target=watch, daemon=True).start()
    while True:
        changed = dirty.wait(timeout=SAVE_EVERY)
        if changed:
            time.sleep(SAVE_DELAY)
            dirty.clear()
        if frozen:
            continue
        if session_ending():
            frozen = True
            log("fin de session : instantané gelé")
            continue
        try:
            write_snapshot(snapshot())
        except Exception as e:  # keep the daemon alive whatever one save hits
            log("sauvegarde impossible :", e)


def show():
    snap = load()
    if not snap:
        print("Aucune session enregistrée.")
        return
    print(f"Session du {snap.get('saved')} : {len(snap['windows'])} fenêtre(s)")
    for w in snap["windows"]:
        where = f"bureau {w['workspace']}" + (" · flottante" if w.get("floating") else "")
        if "tabs" in w:
            print(f"  Ghostty ({where}) : {len(w['tabs'])} onglet(s)")
            for t in w["tabs"]:
                folder = t["cwd"].replace(str(HOME), "~", 1)
                print(f"    {folder}" + (f"  → {t['command']}" if t["command"] else ""))
        else:
            print(f"  {w['class']} ({where}) : {shlex.join(w['cmd'])[:90]}")


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "show"
    if command == "daemon":
        daemon()
    elif command == "save":
        write_snapshot(snapshot())
        show()
    elif command == "restore":
        snap = load(sys.argv[2]) if len(sys.argv) > 2 else load()
        if not snap:
            sys.exit("dotfiles-session : aucune session à rouvrir")
        restore(snap)
    elif command == "show":
        show()
    elif command == "map":
        print(f"{map_tabs()} onglet(s) rattaché(s) à leur fenêtre.")
        write_snapshot(snapshot())
        show()
    elif command == "clear":
        SKIP_NEXT.parent.mkdir(parents=True, exist_ok=True)
        SKIP_NEXT.touch()
        print("Rien ne se rouvrira à la prochaine connexion (une fois).")
    else:
        print(__doc__)
        sys.exit(0 if command in ("-h", "--help", "help") else 2)


if __name__ == "__main__":
    main()
