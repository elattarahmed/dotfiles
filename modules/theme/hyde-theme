  <div class="dlg-body">
    <div class="stage"><img id="d-stage" alt=""></div>
    <div class="strip" id="d-strip"></div>
    <div class="cmd"><code id="d-cmd"></code><button class="chip-btn" id="d-copy">Copier</button></div>
    <div id="d-installed"></div>
  </div>
</dialog>
<script>
const THEMES = /*DATA*/[];
const $ = (id) => document.getElementById(id);
const el = (tag, props = {}, ...kids) => {
  const n = document.createElement(tag);
  for (const [k, v] of Object.entries(props)) {
    if (k === "text") n.textContent = v; else if (k === "style") n.style.cssText = v; else n.setAttribute(k, v);
  }
  kids.forEach((k) => k && n.append(k));
  return n;
};
const safeColor = (c) => /^#[0-9a-f]{6}$/i.test(c || "") ? c : "";
const safeHttp = (u) => /^https:\/\/github\.com\//.test(u || "") ? u : "";

function card(t) {
  const shot = t.shots[0];
  const thumb = el("div", { class: "thumb" },
    shot ? el("img", { src: shot, alt: "", loading: "lazy", decoding: "async" }) : null,
    t.shots.length > 1 ? el("span", { class: "count", text: t.shots.length + " captures" }) : null);
  const sw = el("div", { class: "swatches" });
  [t.bg, t.fg].map(safeColor).filter(Boolean).forEach((c) => sw.append(el("i", { class: "sw", style: "background:" + c, title: c })));
  const title = el("div", { class: "title" }, el("h2", { text: t.name }), sw);
  const badges = el("div", { class: "title" });
  if (t.active) badges.append(el("span", { class: "badge on", text: "Thème actuel" }));
  else if (t.installed) badges.append(el("span", { class: "badge ok", text: "Installé" }));
  if (t.author) badges.append(el("span", { class: "badge", text: "par " + t.author }));
  const c = el("article", { class: "card", tabindex: "0" }, thumb,
    el("div", { class: "body" }, title, el("p", { class: "desc", text: t.description }), badges));
  c.addEventListener("click", () => open(t));
  c.addEventListener("keydown", (e) => { if (e.key === "Enter") open(t); });
  return c;
}

function render() {
  const q = $("q").value.trim().toLowerCase();
  const only = $("only").getAttribute("aria-pressed") === "true";
  const list = THEMES.filter((t) => (!only || t.installed) &&
    (!q || [t.name, t.description, t.author, t.bg, t.fg].join(" ").toLowerCase().includes(q)));
  $("grid").replaceChildren(...(list.length ? list.map(card) : [el("p", { class: "empty", text: "Aucun thème ne correspond." })]));
  $("count").textContent = list.length + " / " + THEMES.length;
}

function open(t) {
  $("d-name").textContent = t.name;
  const meta = $("d-meta");
  meta.replaceChildren(document.createTextNode((t.description || "") + " "));
  const repo = safeHttp(t.url);
  if (repo) meta.append(el("a", { href: repo, target: "_blank", rel: "noopener", text: "Dépôt du thème ↗" }));
  if (t.author) meta.append(document.createTextNode(" · par " + t.author));

  const stage = $("d-stage"), strip = $("d-strip");
  const show = (i) => {
    stage.src = t.shots[i] || "";
    [...strip.children].forEach((img, j) => img.setAttribute("aria-current", String(i === j)));
  };
  strip.replaceChildren(...t.shots.map((s, i) => {
    const img = el("img", { src: s, alt: "", loading: "lazy" });
    img.addEventListener("click", () => show(i));
    return img;
  }));
  strip.style.display = t.shots.length > 1 ? "" : "none";
  show(0);

  const cmd = t.installed ? 'omarchy theme set ' + t.slug : 'hyde-theme install "' + t.name + '" --set';
  $("d-cmd").textContent = cmd;
  $("d-copy").textContent = "Copier";
  $("d-copy").onclick = () => navigator.clipboard.writeText(cmd).then(() => $("d-copy").textContent = "Copié ✓");

  const box = $("d-installed");
  box.replaceChildren();
  if (t.installed) {
    const pal = el("div", { class: "palette" });
    Object.entries(t.palette).forEach(([k, v]) => {
      const c = safeColor(v);
      if (c) pal.append(el("div", { class: "pc" }, el("i", { style: "background:" + c }), el("span", { text: k + " " + c })));
    });
    box.append(el("h3", { text: "Palette Omarchy (colors.toml)" }), pal);
    if (t.wallpapers.length) {
      const walls = el("div", { class: "walls" });
      t.wallpapers.forEach((w) => walls.append(el("img", { src: w, alt: "", loading: "lazy" })));
      box.append(el("h3", { text: "Fonds d'écran (" + t.wallpapers.length + ")" }), walls);
    }
  } else {
    box.append(el("p", { class: "note", text: "Pas encore installé : la commande ci-dessus le convertit pour Omarchy et l'applique." }));
  }
  $("dlg").showModal();
}

$("q").addEventListener("input", render);
$("only").addEventListener("click", (e) => {
  const b = e.currentTarget; b.setAttribute("aria-pressed", String(b.getAttribute("aria-pressed") !== "true")); render();
});
$("d-close").addEventListener("click", () => $("dlg").close());
$("dlg").addEventListener("click", (e) => { if (e.target === $("dlg")) $("dlg").close(); });
render();
</script>
</body>
</html>
"""


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    command, args = argv[0], argv[1:]

    if command == "list":
        for theme in gallery(refresh="--refresh" in args):
            mark = "✓" if (THEMES / slug(theme["name"])).exists() else " "
            print(f"{mark} {theme['name']:<24} {theme['description'][:90]}")
    elif command == "preview":
        preview(refresh="--refresh" in args, open_page="--no-open" not in args)
    elif command == "installed":
        for path in sorted(THEMES.glob(PREFIX + "*")):
            print(path.name)
    elif command == "install":
        apply = "--set" in args
        missing_only = "--missing" in args
        names = [a for a in args if a not in ("--set", "--missing")]
        if not names:
            die("install attend au moins un nom de thème")
        themes = gallery()
        installed = []
        for name in names:
            theme = find(themes, name)
            if missing_only and (THEMES / slug(theme["name"])).exists():
                continue
            try:
                installed.append(install(theme))
            except subprocess.CalledProcessError as error:
                print(f"  ! {name} : téléchargement impossible ({error.stderr.strip()[:200]})", file=sys.stderr)
        if apply and installed:
            subprocess.run(["omarchy", "theme", "set", installed[-1]], check=False)
    elif command == "remove":
        for name in args:
            path = THEMES / (name if name.startswith(PREFIX) else slug(name))
            if path.is_dir():
                shutil.rmtree(path)
                print(f"  ✓ {path.name} supprimé")
            else:
                print(f"  ! {path.name} n'est pas installé", file=sys.stderr)
    else:
        die(f"commande inconnue : {command} (hyde-theme --help)")


if __name__ == "__main__":
    main(sys.argv[1:])
